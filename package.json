{
  "name": "rssagg",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run lint:md && pnpm run format:check && pnpm run typecheck && pnpm test",
    "lint:md": "markdownlint-cli2",
    "lint": "oxlint --type-aware --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "cf-typegen": "wrangler types",
    "migrate:diff": "atlas migrate diff --env local",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply rssagg --remote",
    "migrate:list": "wrangler d1 migrations list rssagg --remote",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "htmx.org": "2.0.11",
    "lism-css": "1.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@types/node": "^24.0.0",
    "lefthook": "^2.2.2",
    "markdownlint-cli2": "^0.23.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.1"
  }
}
