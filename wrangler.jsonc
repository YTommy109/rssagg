{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rssagg",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",

  // ADR-0005: Access は指定したホスト名しか守らないため、素通りになる
  // workers.dev と Preview URL は無効にする。
  "workers_dev": false,
  "preview_urls": false,

  // 本番ドメイン（routes）は未決のため入れていない。決まったら custom domain の
  // routes を足し、同じホスト名に Access アプリケーションを設定する。

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rssagg",
      // 仮値（全ゼロ）。本物の ID は Cloudflare 側で D1 を作成して払い出した後に差し替える。
      // ローカル（wrangler dev / vitest）は ID を見ないのでこのまま動く。
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],

  // ACCESS_BYPASS（開発時の JWT 検証の迂回）はここに書かない。本番の vars に入ると
  // 迂回が有効になり得るため、.dev.vars でのみ指定する（.dev.vars.example を参照）。
  "vars": {
    // 仮値。Zero Trust の team domain と Access アプリの AUD タグを払い出したら差し替える。
    "ACCESS_TEAM_DOMAIN": "placeholder-team.cloudflareaccess.com",
    "ACCESS_AUD": "placeholder-aud-replace-me",
  },
}
