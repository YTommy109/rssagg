{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rssagg",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",

  // ADR-0005: Access は指定したホスト名しか守らないため、素通りになる
  // workers.dev と Preview URL は無効にする。
  "workers_dev": false,
  "preview_urls": false,

  // Access アプリケーション rssagg の公開ホスト名と同じにする。
  "routes": [{ "pattern": "rssagg.degino.com", "custom_domain": true }],

  // routes があると wrangler dev がリクエストの URL のホスト名を本番のドメインに書き換え、
  // ACCESS_BYPASS の迂回（宛先がローカルホストのときだけ効く）が一度も効かなくなる。
  // ローカルでは localhost を宛先にそろえる。ポートまで書くのは、Worker が見る URL を
  // ブラウザの URL（http://localhost:8787/...）と一致させ、絶対 URL を組み立てても食い違わないため。
  // この値は wrangler dev --remote の zone 解決にも使われるが、remote は使わない（ADR-0007）。
  "dev": { "host": "localhost:8787" },

  // ADR-0013: htmx と Lism CSS を Worker に同梱する。Text として取り込むファイルを指定する。
  // glob は解決後のパスではなく import の指定子（src/routes/static.ts）と照合される。
  // 3 つ目は vitest 用で、あちらは解決後のパスと照合される（無いと CSS が空文字列になる）。
  // **/*.js のように広く指定すると、依存の JS まで文字列になって壊れる。
  "rules": [
    { "type": "Text", "globs": [
        "htmx.org/dist/htmx.min.js",
        "lism-css/main.css",
        "**/lism-css/dist/css/main.css",
      ], "fallthrough": false },
  ],

  "triggers": { "crons": ["0 * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rssagg",
      "database_id": "4f04f6ba-8fa2-48d6-8bb4-520f8d8ad6ad",
      "migrations_dir": "migrations",
    },
  ],

  // ACCESS_BYPASS（開発時の JWT 検証の迂回）はここに書かない。本番の vars に入ると
  // 迂回が有効になり得るため、.dev.vars でのみ指定する（.dev.vars.example を参照）。
  "vars": {
    "ACCESS_TEAM_DOMAIN": "degino.cloudflareaccess.com",
    "ACCESS_AUD": "83b135ba85b12b5a56c35372e653f6f281bb5ca1883e932b561280ef69089f50",
  },
}
